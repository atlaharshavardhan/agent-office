[[0.45, 0.96, "This logo"], [0.96, 2.43, "shouldn't be able to glow"], [2.69, 3.6, "After ten years"], [3.6, 4.81, "Apple brought it back"], [4.81, 6.12, "on the new MacBook Pro"], [6.2, 7.29, "But its OLED screen"], [7.29, 8.2, "only makes light"], [8.2, 9.06, "from the front"], [9.14, 10.08, "There's no light"], [10.08, 10.66, "behind it"], [10.92, 11.93, "So where's the glow"], [11.93, 12.57, "coming from?"], [12.65, 13.87, "Let's open the lid"], [14.13, 15.73, "Hidden behind the screen"], [15.73, 17.0, "are four tiny LEDs"], [17.08, 17.64, "Apple says"], [17.64, 19.09, "it built this light source"], [19.09, 20.09, "just for the logo"], [20.35, 21.39, "A mirror-like layer"], [21.39, 22.49, "bounces their light"], [22.57, 23.46, "a frosted sheet"], [23.46, 24.76, "spreads it out evenly"], [24.84, 25.61, "and it shines"], [25.61, 26.62, "through the logo"], [26.7, 27.8, "No bright spots"], [28.06, 28.58, "It glows"], [28.58, 30.32, "whenever your Mac is awake"], [30.4, 31.74, "Brighter in a bright room"], [31.74, 32.82, "dimmer in a dark one"], [32.9, 33.73, "Don't like it?"], [33.81, 34.51, "Apple lets you"], [34.51, 35.21, "switch it off"], [35.47, 36.65, "Follow InvisiTech"], [36.65, 37.27, "for more"]]