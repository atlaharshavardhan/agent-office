[[0.6, 1.01, "This logo"], [1.01, 2.2, "shouldn't be able to glow"], [2.7, 3.6, "After ten years"], [3.6, 4.78, "Apple brought it back"], [4.78, 6.08, "on the new MacBook Pro"], [6.32, 7.16, "But its OLED screen"], [7.16, 7.86, "only makes light"], [7.86, 8.52, "from the front"], [8.76, 9.46, "There's no light"], [9.46, 9.89, "behind it"], [10.39, 11.19, "So where's the glow"], [11.19, 11.69, "coming from?"], [11.93, 12.96, "Let's open the lid"], [13.46, 14.9, "Hidden behind the screen"], [14.9, 16.03, "are four tiny LEDs"], [16.27, 16.76, "Apple says"], [16.76, 18.04, "it built this light source"], [18.04, 18.92, "just for the logo"], [19.42, 20.5, "A mirror-like layer"], [20.5, 21.63, "bounces their light"], [21.87, 22.64, "a frosted sheet"], [22.64, 23.77, "spreads it out evenly"], [24.01, 24.85, "and it shines"], [24.85, 25.95, "through the logo"], [26.19, 27.29, "No bright spots"], [27.79, 28.18, "It glows"], [28.18, 29.51, "whenever your Mac is awake"], [29.75, 31.07, "Brighter in a bright room"], [31.07, 32.15, "dimmer in a dark one"], [32.39, 32.98, "Don't like it?"], [33.22, 33.72, "Apple lets you"], [33.72, 34.23, "switch it off"], [34.73, 35.43, "Follow InvisiTech"], [35.43, 35.8, "for more"]]