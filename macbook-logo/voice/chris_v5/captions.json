[[0.15, 1.16, "Apple's glowing logo"], [1.16, 1.56, "is back"], [1.75, 2.97, "Older MacBooks borrowed light"], [2.97, 4.15, "from the screen's backlight"], [4.35, 4.79, "But OLED"], [4.79, 5.72, "has no backlight"], [6.0, 6.51, "So how does"], [6.51, 7.17, "the logo glow?"], [7.5, 8.41, "The secret is hidden"], [8.41, 9.09, "inside the lid"], [9.35, 10.49, "Behind the display"], [10.49, 11.7, "sits a light source"], [11.7, 13.23, "built just for the logo"], [13.6, 14.76, "Four tiny LEDs"], [14.76, 16.67, "create the entire glow"], [16.9, 17.76, "iFixit found them"], [17.76, 18.52, "along one edge"], [18.9, 19.85, "A reflective layer"], [19.85, 20.91, "bounces their light"], [21.2, 21.81, "a diffuser"], [21.81, 22.9, "spreads it evenly"], [23.2, 23.77, "and it shines"], [23.77, 24.78, "through the whole logo"], [25.5, 26.18, "The result?"], [26.18, 27.4, "One evenly lit logo"], [27.4, 29.37, "with no screen backlight needed"], [29.55, 30.5, "It even dims and brightens"], [30.5, 31.53, "with the light in your room"], [32.6, 33.6, "And one Terminal command"], [33.6, 34.27, "switches it off"]]