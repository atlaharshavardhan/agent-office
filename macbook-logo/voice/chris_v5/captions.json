[[0.15, 1.16, "Apple's glowing logo"], [1.16, 1.56, "is back"], [1.75, 2.5, "But OLED screens"], [2.5, 3.35, "have no backlight"], [3.5, 4.75, "So how does it glow?"], [5.1, 6.01, "The secret is hidden"], [6.01, 6.69, "inside the lid"], [6.95, 8.09, "Behind the display"], [8.09, 9.3, "sits a light source"], [9.3, 10.83, "built just for the logo"], [11.2, 12.36, "Four tiny LEDs"], [12.36, 14.27, "create the entire glow"], [14.5, 15.36, "iFixit found them"], [15.36, 16.12, "along one edge"], [16.5, 17.45, "A reflective layer"], [17.45, 18.51, "bounces their light"], [18.8, 19.41, "a diffuser"], [19.41, 20.5, "spreads it evenly"], [20.8, 21.37, "and it shines"], [21.37, 22.38, "through the whole logo"], [23.2, 23.88, "The result?"], [23.88, 25.1, "One evenly lit logo"], [25.1, 27.07, "with no screen backlight needed"], [28.05, 29.0, "It even dims and brightens"], [29.0, 30.03, "with the light in your room"], [31.05, 32.05, "And one Terminal command"], [32.05, 32.72, "switches it off"]]