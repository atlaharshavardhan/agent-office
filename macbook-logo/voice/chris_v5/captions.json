[[0.15, 1.16, "Apple's glowing logo"], [1.16, 1.56, "is back"], [1.75, 2.5, "But OLED screens"], [2.5, 3.35, "have no backlight"], [3.5, 4.75, "So how does it glow?"], [5.2, 6.11, "The secret is hidden"], [6.11, 6.79, "inside the lid"], [7.9, 9.04, "Behind the display"], [9.04, 10.25, "sits a light source"], [10.25, 11.78, "built just for the logo"], [12.3, 13.46, "Four tiny LEDs"], [13.46, 15.37, "create the entire glow"], [15.5, 16.36, "iFixit found them"], [16.36, 17.12, "along one edge"], [17.6, 18.55, "A reflective layer"], [18.55, 19.61, "bounces their light"], [20.1, 20.71, "a diffuser"], [20.71, 21.8, "spreads it evenly"], [22.3, 22.87, "and it shines"], [22.87, 23.88, "through the whole logo"], [25.6, 26.28, "The result?"], [26.28, 27.5, "One evenly lit logo"], [27.5, 29.47, "with no screen backlight needed"], [31.3, 32.25, "It even dims and brightens"], [32.25, 33.28, "with the light in your room"], [35.2, 36.2, "And one Terminal command"], [36.2, 36.87, "switches it off"]]