[[0.15, 1.16, "Apple's glowing logo"], [1.16, 1.56, "is back"], [2.1, 3.05, "It even dims and brightens"], [3.05, 4.08, "with the light in your room"], [4.75, 5.75, "And one Terminal command"], [5.75, 6.42, "switches it off"], [7.15, 8.37, "Older MacBooks borrowed light"], [8.37, 9.55, "from the screen's backlight"], [9.75, 10.19, "But OLED"], [10.19, 11.12, "has no backlight"], [11.4, 11.91, "So how does"], [11.91, 12.57, "the logo glow?"], [12.9, 13.81, "The secret is hidden"], [13.81, 14.49, "inside the lid"], [14.75, 15.89, "Behind the display"], [15.89, 17.1, "sits a light source"], [17.1, 18.63, "built just for the logo"], [19.0, 19.87, "Four tiny LEDs"], [19.87, 21.3, "create the entire glow"], [21.6, 22.46, "iFixit found them"], [22.46, 23.22, "along one edge"], [24.0, 24.95, "A reflective layer"], [24.95, 26.01, "bounces their light"], [26.3, 26.91, "a diffuser"], [26.91, 28.0, "spreads it evenly"], [28.3, 28.87, "and it shines"], [28.87, 29.88, "through the whole logo"], [30.7, 31.38, "The result?"], [31.38, 32.6, "One evenly lit logo"], [32.6, 34.57, "with no screen backlight needed"]]