[[0.6, 1.11, "This logo"], [1.11, 2.59, "shouldn't be able to glow"], [2.97, 3.9, "After ten years"], [3.9, 5.12, "Apple brought it back"], [5.12, 6.46, "on the new MacBook Pro"], [6.58, 7.68, "But its OLED screen"], [7.68, 8.61, "only makes light"], [8.61, 9.48, "from the front"], [9.6, 10.55, "There's no light"], [10.55, 11.14, "behind it"], [11.52, 12.55, "So where's the glow"], [12.55, 13.2, "coming from?"], [13.32, 14.54, "Let's open the lid"], [14.92, 16.55, "Hidden behind the screen"], [16.55, 17.84, "are four tiny LEDs"], [17.96, 18.52, "Apple says"], [18.52, 19.99, "it built this light source"], [19.99, 21.01, "just for the logo"], [21.39, 22.44, "A mirror-like layer"], [22.44, 23.56, "bounces their light"], [23.68, 24.57, "a frosted sheet"], [24.57, 25.88, "spreads it out evenly"], [26.0, 26.78, "and it shines"], [26.78, 27.8, "through the logo"], [27.92, 29.02, "No bright spots"], [29.4, 29.92, "It glows"], [29.92, 31.68, "whenever your Mac is awake"], [31.8, 33.16, "Brighter in a bright room"], [33.16, 34.26, "dimmer in a dark one"], [34.38, 35.2, "Don't like it?"], [35.32, 36.02, "Apple lets you"], [36.02, 36.73, "switch it off"], [37.11, 38.3, "Follow InvisiTech"], [38.3, 38.94, "for more"]]