[[0.6, 1.07, "This logo"], [1.07, 2.45, "shouldn't be able to glow"], [2.83, 3.73, "After ten years"], [3.73, 4.91, "Apple brought it back"], [4.91, 6.21, "on the new MacBook Pro"], [6.33, 7.37, "But its OLED screen"], [7.37, 8.25, "only makes light"], [8.25, 9.08, "from the front"], [9.2, 10.0, "There's no light"], [10.0, 10.51, "behind it"], [10.89, 11.91, "So where's the glow"], [11.91, 12.56, "coming from?"], [12.68, 13.77, "Let's open the lid"], [14.15, 15.77, "Hidden behind the screen"], [15.77, 17.06, "are four tiny LEDs"], [17.18, 17.71, "Apple says"], [17.71, 19.1, "it built this light source"], [19.1, 20.06, "just for the logo"], [20.44, 21.37, "A mirror-like layer"], [21.37, 22.36, "bounces their light"], [22.48, 23.3, "a frosted sheet"], [23.3, 24.51, "spreads it out evenly"], [24.63, 25.24, "and it shines"], [25.24, 26.04, "through the logo"], [26.16, 27.29, "No bright spots"], [27.67, 28.15, "It glows"], [28.15, 29.77, "whenever your Mac is awake"], [29.89, 31.31, "Brighter in a bright room"], [31.31, 32.46, "dimmer in a dark one"], [32.58, 33.32, "Don't like it?"], [33.44, 34.12, "Apple lets you"], [34.12, 34.81, "switch it off"], [35.19, 36.25, "Follow InvisiTech"], [36.25, 36.82, "for more"]]