# Copy to .env and fill in. .env is git-ignored.

# Where SQLite + local files live
INVISITECH_DATA_DIR=./data

# Claude Code headless (uses your Claude subscription, no API key)
CLAUDE_BIN=claude
# Optional: pick a model for agents (leave empty for your Claude Code default)
CLAUDE_MODEL=
CLAUDE_TIMEOUT_SECONDS=900

# Telegram bot (create with @BotFather; get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Drive via rclone. Remote name from `rclone config`, e.g. gdrive:InvisiTech
# Leave empty to keep files in ./data/drive (local test mode).
RCLONE_REMOTE=

# Storyboard frame renderer: auto | playwright | chrome | blender | svg
STORYBOARD_RENDERER=auto
CHROME_BIN=
BLENDER_BIN=blender

# Script loop settings
REVIEW_MIN_SCORE=8
MAX_SCRIPT_ROUNDS=4
NARRATION_WPM=150

DASHBOARD_PORT=8765
