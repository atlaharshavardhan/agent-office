[[0.15, 1.39, "Pull one AirPod out"], [1.39, 2.67, "and your music stops"], [2.67, 3.86, "So how did it know?"], [4.6, 5.23, "Inside"], [5.23, 7.16, "there's a tiny skin-detect sensor"], [7.16, 7.93, "on the side that"], [7.93, 9.04, "touches your ear"], [9.04, 10.2, "An infrared light"], [10.2, 11.11, "with a light sensor"], [11.11, 12.17, "right beside it"], [15.4, 16.83, "When it's in your ear"], [16.83, 18.11, "it shines invisible light"], [18.11, 19.18, "into your skin"], [19.18, 20.92, "and reads what bounces back"], [20.92, 21.84, "Skin sends it back"], [21.84, 22.91, "in its own way"], [25.4, 26.13, "A table"], [26.13, 27.07, "or a pocket"], [27.07, 28.11, "doesn't match"], [28.11, 29.88, "Older AirPods used simpler sensors"], [29.88, 31.49, "that a pocket could fool"], [31.49, 33.31, "This one can tell skin apart"], [35.5, 37.39, "The moment it stops seeing skin"], [37.39, 38.58, "the H2 chip knows"], [38.58, 40.36, "and tells your phone to pause"], [45.4, 46.22, "Put it back"], [46.22, 47.09, "it sees skin"], [47.09, 48.41, "and the music plays on"]]