[[1.75, 3.32, "Your music just stopped"], [3.32, 4.53, "So how did your AirPods"], [4.53, 6.0, "know you took one out?"], [6.55, 7.21, "Inside"], [7.21, 9.25, "there's a tiny skin-detect sensor"], [9.25, 10.22, "right where the bud"], [10.22, 11.39, "touches your ear"], [11.39, 12.61, "An infrared light"], [12.61, 14.44, "with a light sensor beside it"], [14.99, 16.5, "When it's in your ear"], [16.5, 17.84, "it shines invisible light"], [17.84, 18.97, "into your skin"], [18.97, 20.8, "and reads what bounces back"], [20.8, 22.03, "Your skin sends it back"], [22.03, 23.16, "in its own way"], [23.71, 24.47, "A table"], [24.47, 25.45, "or a pocket"], [25.45, 27.25, "doesn't match that pattern"], [27.25, 29.1, "Older AirPods used simpler sensors"], [29.1, 30.79, "that a pocket could fool"], [30.79, 32.69, "This one can tell skin apart"], [33.24, 35.27, "The moment it stops seeing skin"], [35.27, 36.56, "the H2 chip knows"], [36.56, 37.63, "and tells your phone"], [37.63, 39.23, "over Bluetooth to pause"], [39.68, 40.64, "Put it back in"], [40.64, 41.78, "it sees skin again"], [41.78, 43.16, "and your music plays on"], [44.33, 46.12, "Follow InvisiTech for more"]]