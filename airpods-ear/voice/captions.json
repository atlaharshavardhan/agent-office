[[1.75, 3.18, "Your music just stopped"], [3.18, 4.28, "So how did your AirPods"], [4.28, 5.61, "know you took one out?"], [6.16, 6.78, "Inside"], [6.78, 8.69, "there's a tiny skin-detect sensor"], [8.69, 9.6, "right where the bud"], [9.6, 10.7, "touches your ear"], [10.7, 11.84, "An infrared light"], [11.84, 13.56, "with a light sensor beside it"], [14.11, 15.52, "When it's in your ear"], [15.52, 16.79, "it shines invisible light"], [16.79, 17.85, "into your skin"], [17.85, 19.57, "and reads what bounces back"], [19.57, 20.73, "Your skin sends it back"], [20.73, 21.79, "in its own way"], [22.34, 23.06, "A table"], [23.06, 23.99, "or a pocket"], [23.99, 25.68, "doesn't match that pattern"], [25.68, 27.43, "Older AirPods used simpler sensors"], [27.43, 29.03, "that a pocket could fool"], [29.03, 30.83, "This one can tell skin apart"], [31.38, 33.31, "The moment it stops seeing skin"], [33.31, 34.52, "the H2 chip knows"], [34.52, 35.53, "and tells your phone"], [35.53, 37.05, "over Bluetooth to pause"], [37.5, 38.48, "Put it back in"], [38.48, 39.66, "it sees skin again"], [39.66, 41.06, "and your music plays on"], [42.21, 44.17, "Follow InvisiTech for more"]]