[[0.3, 2.01, "Can a pillar in front of an exit"], [2.01, 3.08, "get more people out?"], [3.7, 4.83, "Two hundred people"], [4.83, 6.39, "rush for one narrow door"], [6.39, 7.76, "They jam into an arch"], [7.76, 9.26, "and in the first minute"], [9.26, 10.26, "only 47 get out"], [11.2, 12.97, "Put a pillar right at the door"], [12.97, 14.23, "and it blocks the way"], [14.23, 14.68, "Just 18"], [17.2, 18.57, "Move it back, dead centre"], [18.57, 19.62, "and it's still worse"], [19.62, 20.78, "than no pillar at all"], [23.2, 24.79, "But place it just off-centre"], [24.79, 26.33, "about a metre from the door"], [27.0, 28.02, "It takes the push"], [28.02, 29.33, "from the crowd behind"], [29.33, 30.58, "so people at the door"], [30.58, 31.6, "can slip through"], [31.6, 32.26, "59 get out"], [33.2, 33.98, "Everyone is out"], [33.98, 35.42, "in two minutes thirty-eight"], [35.42, 36.92, "instead of three minutes six"], [38.3, 39.57, "A well-placed obstacle"], [39.57, 41.3, "can actually speed up an exit"], [43.15, 44.29, "Follow InvisiTech"], [44.29, 44.9, "for more"]]