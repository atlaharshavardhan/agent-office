[[0.3, 1.51, "Can blocking an exit"], [1.51, 2.72, "get more people out?"], [3.7, 4.4, "In a panic"], [4.4, 6.17, "the crowd locks into an arch"], [6.17, 6.93, "at the door"], [6.93, 7.94, "Only 52 get out"], [8.8, 10.27, "Add a V-shaped splitter"], [10.27, 12.41, "It cuts the crowd into two streams"], [12.41, 13.33, "and 94 get out"], [13.33, 14.19, "Nearly double"], [14.8, 15.4, "Too close"], [15.4, 16.89, "and the gap pinches shut"], [16.89, 19.05, "The splitter becomes the bottleneck"], [19.05, 19.52, "Just 18"], [20.3, 21.05, "Too far back"], [21.05, 22.61, "and the streams merge again"], [22.61, 23.53, "before the door"], [23.53, 24.45, "It barely helps"], [25.8, 26.51, "Make it flat"], [26.51, 28.14, "and the crowd hits it head-on"], [28.14, 29.39, "No better than nothing"], [31.3, 32.55, "At forty-five degrees"], [32.55, 33.4, "one metre back"], [33.4, 35.38, "everyone is out in two minutes two"], [35.38, 36.96, "not two minutes fifty-eight"], [38.3, 39.77, "This is the exit paradox"], [39.77, 40.83, "The right obstacle"], [40.83, 41.94, "speeds up the exit"], [43.15, 44.29, "Follow InvisiTech"], [44.29, 44.9, "for more"]]