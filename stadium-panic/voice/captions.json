[[0.3, 1.36, "Imagine 50,000 people"], [1.36, 2.73, "trying to escape a stadium"], [2.73, 3.44, "Running faster"], [3.44, 5.17, "could actually slow everyone down"], [5.6, 7.43, "Everyone wants to get out first"], [7.43, 8.12, "So they rush"], [8.12, 9.33, "toward the same exit"], [10.3, 11.6, "But when too many people"], [11.6, 13.06, "compete for the same space"], [13.06, 14.09, "a bottleneck forms"], [14.6, 16.16, "The harder they try to move"], [16.16, 17.66, "the less room everyone has"], [19.5, 20.72, "Now watch what happens"], [20.72, 21.77, "when the same crowd"], [21.77, 22.88, "moves more steadily"], [29.9, 31.22, "Under these conditions"], [31.22, 32.95, "the crowd moving more steadily"], [32.95, 34.56, "can actually get out faster"], [38.3, 39.39, "Scientists call this"], [39.39, 40.92, "the faster-is-slower effect"], [43.15, 44.29, "Follow InvisiTech"], [44.29, 44.9, "for more"]]