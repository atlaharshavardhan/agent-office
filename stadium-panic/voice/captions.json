[[0.35, 2.42, "What happens when thousands of people"], [2.42, 3.71, "panic at the same time?"], [3.86, 4.61, "Some people"], [4.61, 5.83, "react immediately"], [5.98, 6.63, "Others wait"], [6.63, 8.27, "watching everyone around them"], [8.9, 10.55, "When information is unclear"], [10.55, 12.78, "people often look to others for clues"], [12.93, 14.23, "One person's reaction"], [14.23, 16.22, "can influence the people nearby"], [16.37, 17.33, "And that reaction"], [17.33, 18.9, "can ripple across the stand"], [20.3, 21.02, "Uncertainty"], [21.02, 22.89, "No one knows what is happening"], [23.6, 24.64, "Social influence"], [24.64, 26.42, "We copy the people around us"], [26.7, 27.35, "And stress"], [27.35, 28.6, "Together, they change"], [28.6, 30.14, "how a whole crowd behaves"], [30.4, 30.99, "That's why"], [30.99, 32.66, "clear communication matters"], [33.0, 34.32, "During an emergency"], [34.32, 35.64, "reliable information"], [35.64, 37.09, "helps people stay calm"], [37.09, 38.15, "and move safely"], [38.6, 39.48, "Clear voices"], [39.48, 40.42, "calmer crowds"], [43.15, 44.35, "Follow InvisiTech"], [44.35, 44.98, "for more"]]