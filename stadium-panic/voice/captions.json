[[0.35, 2.42, "What happens when thousands of people"], [2.42, 3.71, "panic at the same time?"], [3.86, 4.61, "Some people"], [4.61, 5.83, "react immediately"], [5.98, 6.63, "Others wait"], [6.63, 8.27, "watching everyone around them"], [8.9, 10.55, "When information is unclear"], [10.55, 12.78, "people often look to others for clues"], [12.93, 14.23, "One person's reaction"], [14.23, 16.22, "can influence the people nearby"], [16.37, 17.27, "And that reaction"], [17.27, 18.8, "can ripple through the crowd"], [20.3, 21.02, "Uncertainty"], [21.02, 22.89, "No one knows what is happening"], [23.6, 24.64, "Social influence"], [24.64, 26.42, "We copy the people around us"], [26.7, 27.35, "And stress"], [27.35, 28.42, "So almost everyone"], [28.42, 30.38, "heads for the one exit they know"], [30.53, 30.99, "Fix one:"], [30.99, 31.97, "a slanted barrier"], [31.97, 33.18, "in front of the door"], [33.5, 34.38, "In simulations"], [34.38, 35.49, "it splits the push"], [35.49, 37.13, "and the door stops clogging"], [37.28, 37.73, "Fix two:"], [37.73, 38.81, "clear announcements"], [38.81, 40.29, "send people to every exit"], [40.44, 41.38, "Smarter exits"], [41.38, 42.33, "calmer crowds"], [43.15, 44.35, "Follow InvisiTech"], [44.35, 44.98, "for more"]]