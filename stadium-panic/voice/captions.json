[[0.35, 2.42, "What happens when thousands of people"], [2.42, 3.71, "panic at the same time?"], [3.86, 4.61, "Some people"], [4.61, 5.83, "react immediately"], [5.98, 6.63, "Others wait"], [6.63, 8.27, "watching everyone around them"], [8.9, 10.55, "When information is unclear"], [10.55, 12.78, "people often look to others for clues"], [12.93, 14.23, "One person's reaction"], [14.23, 16.22, "can influence the people nearby"], [16.37, 17.27, "And that reaction"], [17.27, 18.8, "can ripple through the crowd"], [20.3, 21.02, "Uncertainty"], [21.02, 22.89, "No one knows what is happening"], [23.6, 24.64, "Social influence"], [24.64, 26.42, "We copy the people around us"], [26.7, 27.35, "And stress"], [27.35, 28.42, "So almost everyone"], [28.42, 30.38, "heads for the one exit they know"], [30.53, 31.12, "That's why"], [31.12, 32.79, "clear communication matters"], [33.0, 34.32, "During an emergency"], [34.32, 35.64, "reliable information"], [35.64, 37.09, "helps people stay calm"], [37.09, 38.15, "and move safely"], [38.6, 40.37, "People spread across the exits"], [40.37, 41.51, "and the crowd flows"], [43.15, 44.35, "Follow InvisiTech"], [44.35, 44.98, "for more"]]